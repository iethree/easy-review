{
  "name": "easy-review",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "latest",
    "@types/mdast": "^4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45",
    "electron-builder": "^26"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@mantine/core": "^9",
    "@mantine/hooks": "^9",
    "@mantine/notifications": "^9",
    "@tabler/icons-react": "^3.46.0",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10",
    "rehype-raw": "^7",
    "rehype-sanitize": "^6",
    "remark-gfm": "^4",
    "remark-parse": "^11",
    "unified": "^11"
  },
  "description": "Fast, keyboard-driven triage for the pull requests waiting on your review.",
  "scripts": {
    "dev": "bun --hot dev.ts",
    "start": "bun main.ts",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "desktop": "bun scripts/desktop.ts",
    "desktop:build": "bun scripts/desktop.ts --build",
    "lint": "biome lint --error-on-warnings ."
  }
}
